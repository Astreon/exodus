# Copy this file to `.env` (gitignored) to build with a Microsoft client ID.
# Leave it unset or empty to build without one; sign in is then unavailable.
# The environment variable of the same name wins over this file.
#
# After creating `.env` for the first time, run `cargo clean -p exodus-core`
# once; from then on, changes to `.env` are picked up automatically.
EXODUS_MSA_CLIENT_ID=
